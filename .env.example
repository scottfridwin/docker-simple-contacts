# Copy to .env for local development: cp .env.example .env
# Backend server
PORT=8080
LOG_LEVEL=debug
ENV=development

# Database connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=contacts
DB_PASSWORD=contacts
# DB_PASSWORD_FILE takes precedence over DB_PASSWORD when both are set.
# DB_PASSWORD_FILE=/run/secrets/db_password
DB_NAME=postgres
DB_SSLMODE=disable

# Comma-separated allow-list of browser origins (development defaults).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Soft-delete purge window in days (recycle bin retention).
PURGE_AFTER_DAYS=30
