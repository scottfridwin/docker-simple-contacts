# Copy to .env for local development: cp .env.example .env
# Image tags used by docker compose (published on GHCR).
CONTACTS_VERSION=latest
# BACKEND_IMAGE=ghcr.io/scottfridwin/contacts-backend
# FRONTEND_IMAGE=ghcr.io/scottfridwin/contacts-frontend

# Published ports
APP_PUBLISH_PORT=8080
FRONTEND_PUBLISH_PORT=5173
POSTGRES_PUBLISH_PORT=5432

# Runtime users for hardened Compose deployment
POSTGRES_UID=70
POSTGRES_GID=70
APP_UID=65532
APP_GID=65532
FRONTEND_UID=101
FRONTEND_GID=101

# Reasonable runtime limits
POSTGRES_MEM_LIMIT=512m
POSTGRES_PIDS_LIMIT=256
APP_MEM_LIMIT=256m
APP_PIDS_LIMIT=128
FRONTEND_MEM_LIMIT=128m
FRONTEND_PIDS_LIMIT=64

# Backend server
PORT=8080
LOG_LEVEL=debug
ENV=development

# Database connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=contacts
DB_NAME=postgres
DB_SSLMODE=disable

# Docker Compose mounts this secret into both postgres and the backend.
DB_PASSWORD_SECRET_FILE=./secrets/db_password
# Used by the local source-build override and by non-compose runs.
DB_PASSWORD=contacts
# DB_PASSWORD_FILE takes precedence over DB_PASSWORD when both are set.
# DB_PASSWORD_FILE=/run/secrets/db_password

# Comma-separated allow-list of browser origins (development defaults).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Soft-delete purge window in days (recycle bin retention).
PURGE_AFTER_DAYS=30
